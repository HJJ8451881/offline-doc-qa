# Ollama（本機推論服務，需先 `ollama serve` 或系統服務已啟動）
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:7b

# PostgreSQL + pgvector
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=docqa
POSTGRES_PASSWORD=docqa
POSTGRES_DB=docqa

# 切塊與檢索參數
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
